---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSkills = await getCollection('skills');

const categories = ['engineering', 'productivity', 'creative', 'ops'] as const;
const categoryLabels: Record<string, string> = {
  engineering: 'Engineering',
  productivity: 'Productivity',
  creative: 'Creative',
  ops: 'Ops',
};

const byCategory = Object.fromEntries(
  categories.map(cat => [
    cat,
    allSkills.filter(s => s.id.startsWith(cat + '/')).sort((a, b) =>
      a.data.name.localeCompare(b.data.name)
    ),
  ])
);
---

<Layout title="crush-skills — AI agent skills for real engineering">
  <section class="hero">
    <div class="hero-eyebrow">agent skills</div>
    <h1 class="hero-headline">Ship real code.<br /><span class="accent">Stop vibe coding.</span></h1>
    <p class="hero-sub">A curated collection of original and adopted AI agent skills for engineers who care about quality. Works with Crush, Claude Code, Cursor, Windsurf, and GitHub Copilot.</p>
    <div class="hero-ctas">
      <a href="https://github.com/ericdahl-dev/skills#quick-install" class="cta-primary">Install in 30 seconds</a>
      <a href="https://github.com/ericdahl-dev/skills" class="cta-secondary">View on GitHub →</a>
    </div>
    <div class="install-snippet">
      <span class="prompt">$</span>
      <code>git clone https://github.com/ericdahl-dev/skills ~/.skills &amp;&amp; cd ~/.skills &amp;&amp; ./scripts/link-skills.sh</code>
    </div>
    <div class="attribution-bar">
      <span>Original skills by <a href="https://github.com/ericdahl-dev" target="_blank" rel="noopener">ericdahl-dev</a></span>
      <span class="sep">·</span>
      <span>Adopted from <a href="https://github.com/mattpocock/skills" target="_blank" rel="noopener">mattpocock/skills</a> and <a href="https://github.com/codecoincognition/vibe-guard-skills" target="_blank" rel="noopener">codecoincognition/vibe-guard-skills</a></span>
    </div>
  </section>

  {categories.map(cat => (
    <section class="skills-section">
      <div class="section-label">{categoryLabels[cat]}</div>
      <div class="skill-grid">
        {byCategory[cat].map(skill => (
          <a href={`${import.meta.env.BASE_URL}/skills/${skill.id.replace(/\/SKILL$/i, '')}`} class="skill-card">
            <div class="skill-name">{skill.data.name}</div>
            <div class="skill-desc">{skill.data.description.slice(0, 100)}{skill.data.description.length > 100 ? '…' : ''}</div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

<style>
  .hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
    animation: fade-up 0.6s ease both;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .hero-headline {
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero-headline .accent { color: var(--accent); }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-dim);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .hero-ctas { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 2rem; }
  .cta-primary {
    background: var(--accent);
    color: #000;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius);
    transition: opacity 0.15s;
  }
  .cta-primary:hover { opacity: 0.85; text-decoration: none; }
  .cta-secondary {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    border: 1px solid var(--border);
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius);
    transition: border-color 0.15s, color 0.15s;
  }
  .cta-secondary:hover { border-color: var(--text-dim); color: var(--text); text-decoration: none; }
  .install-snippet {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    max-width: 100%;
    overflow-x: auto;
  }
  .install-snippet .prompt { color: var(--accent); user-select: none; }
  .install-snippet code { color: var(--text); background: none; padding: 0; font-size: inherit; white-space: nowrap; }

  .attribution-bar {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .attribution-bar a { color: var(--text-muted); text-decoration: underline; text-underline-offset: 3px; }
  .attribution-bar a:hover { color: var(--accent); }
  .attribution-bar .sep { color: var(--border); }

  .skills-section { padding: 3rem 0 1rem; animation: fade-up 0.5s ease both; animation-delay: 0.1s; }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .skill-card {
    background: var(--bg-card);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.15s;
    color: inherit;
  }
  .skill-card:hover { background: var(--bg-card-hover); text-decoration: none; }
  .skill-card:hover .skill-name { color: var(--accent); }
  .skill-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text);
    transition: color 0.15s;
  }
  .skill-name::before { content: '/'; color: var(--text-muted); }
  .skill-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; }

  @media (max-width: 640px) {
    .hero { padding: 3rem 0 2.5rem; }
    .skill-grid { grid-template-columns: 1fr; }
    .install-snippet { font-size: 0.7rem; }
  }
</style>
