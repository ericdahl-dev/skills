---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map(skill => ({
    params: { slug: skill.id.replace(/\/SKILL$/i, '') },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const category = skill.id.split('/')[0];
const githubUrl = `https://github.com/ericdahl-dev/skills/blob/main/skills/${skill.id}`;
---

<Layout title={`/${skill.data.name} — crush-skills`} description={skill.data.description}>
  <article class="skill-page">
    <a href={`${import.meta.env.BASE_URL}`} class="back-link">← all skills</a>
    <header class="skill-header">
      <div class="skill-category">{category}</div>
      <h1 class="skill-name">/{skill.data.name}</h1>
      <p class="skill-desc">{skill.data.description}</p>
      <a href={githubUrl} class="source-link" target="_blank" rel="noopener">View source on GitHub →</a>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .skill-page { padding: 3rem 0 6rem; max-width: 720px; }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: 2.5rem;
  }
  .back-link:hover { color: var(--accent); text-decoration: none; }

  .skill-header { margin-bottom: 3rem; }

  .skill-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .skill-name {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .skill-desc {
    font-size: 1rem;
    color: var(--text-dim);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 1.25rem;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }
  .source-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .source-link:hover { color: var(--accent); }

  .prose { font-size: 0.95rem; line-height: 1.75; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-mono);
    color: var(--text);
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .prose :global(h1) { font-size: 1.5rem; }
  .prose :global(h2) { font-size: 1.15rem; color: var(--text-dim); }
  .prose :global(h2)::before { content: '## '; color: var(--text-muted); }
  .prose :global(h3) { font-size: 1rem; color: var(--text-dim); }
  .prose :global(h3)::before { content: '### '; color: var(--text-muted); }
  .prose :global(p) { margin-bottom: 1rem; color: var(--text-dim); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; color: var(--text-dim); }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.1em 0.4em;
    border-radius: 2px;
    color: var(--accent);
  }
  .prose :global(pre) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.83rem;
    color: var(--text-dim);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1rem;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 1.25rem; font-size: 0.88rem; }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose :global(td) { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--text-dim); }
  .prose :global(tr:hover td) { background: var(--bg-card); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
</style>
